MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/recipebook?retryWrites=true&w=majority
PORT=8080
SWAGGER_HOST=localhost:8080

# GitHub OAuth app (Settings > Developer settings > OAuth Apps).
# Set the callback URL above to <host>/auth/github/callback.
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:8080/auth/github/callback
# Random string used to sign the session cookie.
SESSION_SECRET=replace-with-a-long-random-string
